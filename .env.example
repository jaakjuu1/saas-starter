# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.

# Database
POSTGRES_URL=postgresql://user:password@localhost:5432/saas_seo_ai

# Authentication
AUTH_SECRET=your-auth-secret-here
BASE_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_***

# Claude Code SDK (for worker processing)
ANTHROPIC_API_KEY=sk-ant-api03-***
CLAUDE_CODE_SDK_CONFIG={"tools": ["firecrawl", "datafor_seo", "playwright"]}

# Redis (for job queue)
REDIS_URL=redis://localhost:6379

# External APIs
DATAFOR_SEO_LOGIN=your-login
DATAFOR_SEO_PASSWORD=your-password
FIRECRAWL_API_KEY=fc-***

# File Storage (optional - defaults to local)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Google Analytics 4 (optional)
GA4_SERVICE_ACCOUNT_KEY_PATH=./ga4-service-account.json